source_mismatches = con.execute(
    f"""
    SELECT COUNT(*)

    FROM read_csv_auto(
        '{qpath(AFTER)}',
        HEADER=TRUE,
        ALL_VARCHAR=TRUE,
        SAMPLE_SIZE=-1,
        MAX_LINE_SIZE=100000000
    ) AS a

    JOIN read_parquet(
        '{qpath(CANONICAL)}'
    ) AS c
      ON c.source_row_uid =
         a.ssot_source_row_uid

    WHERE COALESCE(
              a.ssot_source_text_exact,
              ''
          )
          <>
          COALESCE(
              c.wikidisputes_text_exact,
              ''
          )
    """
).fetchone()[0]

source_mismatches = int(
    source_mismatches
)



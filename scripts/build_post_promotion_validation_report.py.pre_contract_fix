population = con.execute(
    f"""
    SELECT
        COUNT(*),

        COUNT(*) FILTER (
            WHERE utterance_role='utterance'
        ),

        COUNT(*) FILTER (
            WHERE utterance_role='context'
        ),

        COUNT(
            DISTINCT ssot_source_row_uid
        ),

        COUNT(
            DISTINCT ssot_logical_utterance_uid
        ) FILTER (
            WHERE utterance_role='utterance'
        ),

        COUNT(*) FILTER (
            WHERE utterance_role='utterance'
              AND COALESCE(
                    TRIM(utterance_text),
                    ''
                  ) = ''
        )

    FROM read_csv_auto(
        '{qpath(AFTER)}',
        HEADER=TRUE,
        ALL_VARCHAR=TRUE,
        SAMPLE_SIZE=-1,
        MAX_LINE_SIZE=100000000
    )
    """
).fetchone()

(
    total_rows,
    utterance_rows,
    context_rows,
    distinct_source_rows,
    logical_utterances,
    empty_utterances,
) = map(
    int,
    population,
)


